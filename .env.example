POSTGRES_PASSWORD=guild
OIDC_ISSUER=https://sso.example.com/realms/bitnp
OIDC_CLIENT_ID=guild-backend
OIDC_CLIENT_SECRET=replace-with-client-secret
APP_PUBLIC_URL=https://guild.example.com
# Only for a new deployment; existing admins must be explicitly bound instead.
OIDC_BOOTSTRAP_ADMIN_SUBJECT=
APP_SESSION_TIMEOUT=30m
APP_SECURE_COOKIE=true
RUSTFS_ACCESS_KEY=dev-access-key
RUSTFS_SECRET_KEY=dev-secret-key-change-me
S3_BUCKET=guild
